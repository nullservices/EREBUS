# ── EREBUS configuration ─────────────────────────────────────────────
# Copy to .env (or set in your shell) and adjust as needed.
# All values are optional; defaults shown below.

# Directory for the SQLite database and generated secret keys.
# Default: ./data (relative to where EREBUS is started).
# NOTE: this project folder is inside OneDrive — exclude `data/` from
# OneDrive sync, or point this at a non-synced location, e.g. C:\erebus-data
EREBUS_DATA_DIR=./data

# Dev server bind address. Use 0.0.0.0 to allow LAN access:
#   NITRO_HOST=0.0.0.0 npm run dev
# (or simply: npm run dev:lan)
# NOTE: npm 12 intercepts flags forwarded with `--`, so
# `npm run dev -- --host 0.0.0.0` no longer works — use dev:lan or the
# environment variable instead.
NITRO_HOST=127.0.0.1

# Dev server port (also honored by the production build):
NITRO_PORT=4521
